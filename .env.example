# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/shift_airdrop

# Helius
HELIUS_API_KEY=your_helius_api_key
HELIUS_WEBHOOK_SECRET=your_webhook_secret

# Jupiter Price API
JUPITER_PRICE_API=https://api.jup.ag/price/v2

# SNAG Loyalty
SNAG_API_KEY=your_snag_api_key
SNAG_ORGANIZATION_ID=your_org_id
SNAG_WEBSITE_ID=your_website_id
SNAG_BASE_URL=https://admin.snagsolutions.io
SNAG_LOYALTY_CURRENCY_ID=your_loyalty_currency_id
SNAG_WEBHOOK_SECRET=your_webhook_secret_for_hmac

# SNAG Badge Rule IDs (external rules for badge awards)
SNAG_XP_RULE_ID=
SNAG_FIRST_TRADE_BADGE_ID=
SNAG_DIAMOND_HANDS_BADGE_ID=
SNAG_EARNINGS_REACTOR_BADGE_ID=
SNAG_FOMC_TRADER_BADGE_ID=
SNAG_SHIFT_HOLDER_BADGE_ID=

# SNAG Social Task Rule IDs (for inbound webhook verification)
SNAG_FOLLOW_X_RULE_ID=
SNAG_JOIN_DISCORD_RULE_ID=
SNAG_JOIN_TELEGRAM_RULE_ID=
SNAG_CONNECT_WALLET_RULE_ID=
SNAG_FIRST_TRADE_RULE_ID=

# Server
PORT=3001
NODE_ENV=development

# Anti-Farm Config
MIN_POSITION_SIZE_USD=10
MIN_HOLD_HOURS=24
WASH_TRADE_WINDOW_MINUTES=5
COOLDOWN_MINUTES=60
